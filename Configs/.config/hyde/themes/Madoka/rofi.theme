$HOME/.config/rofi/theme.rasi
* {
    main-bg:            #b5d7e8;
    main-fg:            #474a4fff;
    main-br:            #f3f0b4;
    main-ex:            #ccff00cc;
    select-bg:          #11ff00ff;
    select-fg:          rgba(255, 0, 0, 1);
    separatorcolor:     transparent;
    border-color:       transparent;
    font: "Jetbrains Mono 11";
}
